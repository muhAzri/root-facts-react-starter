{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noFallthroughCasesInSwitch": true,

    // Banyak method service masih berupa stub (TODO) yang parameternya belum
    // dipakai sampai diimplementasikan, jadi dua rule ini sengaja dimatikan.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}
